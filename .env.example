# Copy this file to .env and replace the placeholder values.
# Never commit your real .env file.

# Server
PORT=3000
NODE_ENV=development

# MongoDB connection string (local or MongoDB Atlas).
# The application always uses the database "comp3123_assignment1",
# even if a different database name is present in the URI.
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017

# JWT signing secret - use a long random value (at least 32 characters).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
# Token lifetime (e.g. 15m, 1h, 1d). A plain number is treated as seconds.
JWT_EXPIRES_IN=1h

# bcrypt cost factor used when hashing passwords
BCRYPT_SALT_ROUNDS=12

# Rate limiting (window values are in milliseconds)
# General limit for every /api route
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Authentication endpoints
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Maximum FAILED login attempts per IP per window
LOGIN_RATE_LIMIT_MAX=5
# Maximum signup requests per IP per window
SIGNUP_RATE_LIMIT_MAX=20

# Set to 1 (or the number of proxies) when deployed behind a reverse proxy
# such as Render/Heroku/Nginx so client IPs are detected correctly.
TRUST_PROXY=false

# Allowed CORS origin(s), comma separated. Use * to allow any origin.
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
LOG_DIR=logs
